<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="V005-1" author="cesizen">
        <createTable tableName="interpretation">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="score_min" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="score_max" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="niveau_stress" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="message_resultat" type="TEXT"/>
            <column name="id_questionnaire" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="interpretation"
                baseColumnNames="id_questionnaire"
                constraintName="fk_interpretation_questionnaire"
                referencedTableName="questionnaire"
                referencedColumnNames="id"
                onDelete="CASCADE"/>
    </changeSet>

</databaseChangeLog>