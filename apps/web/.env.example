# URL de l'API backend (remplacer selon l'environnement)
# Développement local (navigateur) :
VITE_API_URL=http://localhost:8080

# Sur un appareil Android physique connecté en USB,
# remplacez par l'IP locale de votre machine :
# VITE_API_URL=http://192.168.x.x:8080

# En production :
# VITE_API_URL=https://api.cesizen.fr
